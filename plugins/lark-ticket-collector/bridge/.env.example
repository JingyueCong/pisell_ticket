# Feishu self-built app. Keep these values in a secret manager in production.
LARK_APP_ID=cli_xxx
LARK_APP_SECRET=replace_me

# lark-cli profile bound to the same app. Used to fetch message resources.
LARK_CLI_PROFILE=ticket-collector
LARK_CLI_BIN=lark-cli

# Only these chats and senders may trigger the bot. Comma-separated IDs.
ALLOWED_CHAT_IDS=oc_xxx
ALLOWED_SENDER_IDS=
REQUIRE_MENTION=true

# Optional production features. Leave blank to disable the corresponding automation.
YOKO_HANDOFF_CHAT_ID=
OPS_ALERT_CHAT_ID=
OPS_ALERT_COOLDOWN_MS=300000
# Trusted group name format: 制作：Name A/Name B 确认：Name C
CONTENT_PRODUCER_SOURCE_CHAT_ID=
# Customer groups where a posted Feishu Minutes link automatically creates one
# customer-service "上门服务工单" without requiring an @ mention.
VISIT_RECORD_CHAT_IDS=
# When true, every group the bot is deliberately added to accepts Feishu Minutes
# links. Ordinary ticket messages remain restricted by ALLOWED_CHAT_IDS.
AUTO_VISIT_RECORD_GROUPS=false

# Headless Codex runtime containing this plugin and an authenticated Meegle CLI.
BRIDGE_WORKSPACE=/absolute/path/to/ticket-collector-workspace
CODEX_BIN=codex
CODEX_MODEL=
CODEX_PROFILE=
CODEX_TIMEOUT_MS=600000
# Real no-write structured-output check performed once at service startup.
CODEX_PROBE_TIMEOUT_MS=30000
# Background probe runs only while no employee request is using Codex.
CODEX_PROBE_INTERVAL_MS=1800000
CODEX_PROBE_FAILURE_THRESHOLD=2
CODEX_MAX_CONCURRENT_RUNS=2

# Make the Meegle system creator equal the Feishu message sender. Each employee
# completes OAuth once; requests never fall back to another employee's profile.
PER_USER_MEEGLE_AUTH=false
MEEGLE_BIN=meegle
MEEGLE_HOST=project.feishu.cn
MEEGLE_PROJECT_KEY=v2qint
# Optional comma-separated sender_open_id=existing_meegle_profile overrides.
MEEGLE_PROFILE_OVERRIDES=

# Persistent runtime data. Do not place this inside the plugin package in production.
BRIDGE_DATA_DIR=./var
BRIDGE_DB_PATH=./var/bridge.sqlite
BRIDGE_RESOURCE_DIR=./var/resources

# Optional health endpoint for container probes.
HEALTH_HOST=127.0.0.1
HEALTH_PORT=8787

# Optional loopback-only API used by the merchant/customer-information bot to
# hand an unanswered support request to this same Ticket Collector Agent.
# Both values are required to enable POST /internal/customer-service-tickets.
INTERNAL_API_TOKEN=
INTERNAL_TICKET_SENDER_ID=
INTERNAL_TICKET_SENDER_NAME=

# Keep replies below Feishu message limits and avoid flooding a group.
MAX_REPLY_CHARS=12000
# Only recent, relevant context is sent to Codex. Stored rows are not deleted.
MAX_HISTORY_MESSAGES=12
MAX_HISTORY_AGE_DAYS=30

# Incomplete structured ticket drafts expire after seven days.
DRAFT_TTL_HOURS=168
MAX_RESOURCE_BYTES=26214400

# Local attachment files and audit rows are pruned independently. Files still
# referenced by an open draft are always retained.
RESOURCE_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=180
MAINTENANCE_INTERVAL_MS=3600000
